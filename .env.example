# 貓狗大戰 — 環境變數範例
# 複製成 .env 只給本機參考；.env 已被 .gitignore 排除。
# 正式值請放在部署平台的環境變數／repository secrets，不要提交進 Git。

# ---------------------------------------------------------------- 前端

# 前端要連的遊戲伺服器位址。
# 唯一的設定入口是 public/js/config.js，部署時由 scripts/inject-server-url.js 注入。
#
# 留空 = 用「同源」：前端由這台 server.js 送出來時會自動連回同一台，
#        這是最常見也最省事的用法（本機、Render 單一服務都適用）。
# 只有「前端和伺服器分開部署」（例如前端放 GitHub Pages）才需要填。
#
# 本機測試：node scripts/inject-server-url.js --allow-local http://localhost:3020
# 正式部署：GAME_SERVER_URL=https://你的服務網址 node scripts/inject-server-url.js
GAME_SERVER_URL=

# ---------------------------------------------------------------- 伺服器

# 監聽的埠與介面。Render、Railway 之類的平台會自動注入 PORT。
PORT=3020
HOST=0.0.0.0

# 允許跨來源連線的前端網址，逗號分隔；* 表示不限制。
# 正式環境請明確填寫，例如：GAME_ALLOWED_ORIGIN=https://你的帳號.github.io
GAME_ALLOWED_ORIGIN=*

# 每回合的思考時間（毫秒）。時間到伺服器會自動跳過那一回合並寫進操作摘要。
ROOM_TURN_MS=15000

# 電腦對手的思考延遲倍率。1 = 正常；自動化測試會設成 0 讓它立刻出手。
AI_THINK_SCALE=1
